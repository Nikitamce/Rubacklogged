{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_extName__",
  "description": "__MSG_extDesc__",
  "version": "2.1.0",
  "minimum_chrome_version": "102",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://backloggd.com/*",
    "*://www.backloggd.com/*",
    "*://store.steampowered.com/*",
    "*://api.steampowered.com/*",
    "*://steamdb.info/*",
    "*://howlongtobeat.com/*",
    "*://*.protondb.com/*",
    "*://*.opencritic.com/*",
    "*://*.gamestatus.info/*",
    "*://*.pcgamingwiki.com/*",
    "*://*.isthereanydeal.com/*",
    "*://*.steamcharts.com/*",
    "*://*.augmentedsteam.com/*",
    "*://*.gameslike.co/*",
    "*://*.gogdb.org/*",
    "*://*.jsdelivr.net/*",
    "*://*.pages.dev/*",
    "*://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://backloggd.com/*",
        "*://www.backloggd.com/*"
      ],
      "js": [
        "lib/gm-polyfill.js",
        "lib/engine.js",
        "locales/ru.js",
        "content.js",
        "lib/plus-bundle.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://store.steampowered.com/*",
        "*://steamdb.info/*"
      ],
      "js": [
        "lib/gm-polyfill.js",
        "lib/plus-bundle.js"
      ],
      "run_at": "document_end"
    }
  ]
}
