{
  "name": "backloggd-plus",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Userscript that extends Backloggd with extra game information, richer UI, and QoL features",
  "author": "NemoKing1210",
  "license": "MIT",
  "homepage": "https://github.com/NemoKing1210/backloggd-plus",
  "bugs": {
    "url": "https://github.com/NemoKing1210/backloggd-plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NemoKing1210/backloggd-plus.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/sync-locale.mjs && vite",
    "test": "node --test tests/*.test.mjs",
    "sync:locale": "node scripts/sync-locale.mjs",
    "build": "node scripts/sync-locale.mjs && vite build && node scripts/copy-dist.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "ci": "npm test && npm run build && npm run verify:artifacts",
    "preview": "vite preview"
  },
  "devDependencies": {
    "terser": "^5.51.2",
    "vite": "^8.3.8",
    "vite-plugin-monkey": "^8.1.1"
  }
}
